<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.asule.springmini.mapper.TaskMapper">

    <!--  二级缓存 -->
    <!--<cache />-->
    <resultMap id="dataMap" type="com.asule.springmini.entity.Task">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="topic" property="topic"/>
        <result column="message_id" property="messageId"/>
        <result column="message" property="message"/>
        <result column="state" property="state"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 任务表常用字段，后续查询可以通过 <include refid="Base_Column_List"/> 复用 -->
    <sql id="Base_Column_List">
        id, user_id, topic, message_id, message, state, create_time, update_time
    </sql>

    <select id="queryNoSendMessageTaskList" resultMap="dataMap">
        select user_id, topic, message_id, message
        from big_market_01.task
        where state = 'fail' or (state = 'create' and now() - update_time > 6)
            limit 10
    </select>

    <select id="queryTaskByMsg" parameterType="string" resultMap="dataMap" statementType="PREPARED">
        select user_id, topic, message_id, message
        from big_market_01.task
        where message_id = #{msgId}
    </select>

    <select id="getTasks" parameterType="string" resultMap="dataMap">
        SELECT <include refid="Base_Column_List"/> from big_market_01.task where user_id = #{userId};
    </select>

    <select id="getTasksOrder" parameterType="map" resultMap="dataMap">
        SELECT * from big_market_01.task where user_id = #{userId} order by ${orderBy};
    </select>
</mapper>
